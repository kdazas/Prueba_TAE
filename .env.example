# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env al repositorio.
# En CI (Azure DevOps) estos valores vienen de las variables del pipeline, no de un archivo.

# --- Ambiente ---
# Los endpoints /test-support solo existen en QA. Si no es "qa", las fixtures se niegan a usarlos.
TEST_ENV=qa
# URL del frontend (Angular). La usan las pruebas de pantalla.
BASE_URL=http://localhost:4200
# URL de la API (FastAPI). La usan las pruebas de API.
API_URL=http://localhost:8000

# --- Datos de prueba ---
# Espacios reservados para pruebas automatizadas, uno por worker. La cantidad define los workers.
ESPACIOS_PRUEBA=PRUEBA-01,PRUEBA-02,PRUEBA-03,PRUEBA-04
# Espacios para las pruebas que mueven el reloj (corren de a una).
ESPACIO_RELOJ_A=PRUEBA-RELOJ-A
ESPACIO_RELOJ_B=PRUEBA-RELOJ-B
# Cuántas veces se repite la prueba de solicitudes simultáneas (en la nocturna se puede subir a 20).
INTENTOS_CONCURRENCIA=5

# --- Ejecución (normalmente se pasan en la línea de comandos, no aquí) ---
# EJECUCION=nocturna  → activa 1 reintento para DETECTAR pruebas inestables
# MOCK=1              → Playwright levanta el mock de la API (solo demo)
# BUG_SIN_LIMITE=1 / BUG_CARRERA=1 / BUG_LIBERA_TODO=1 → defectos del mock (solo demo)

# QA_RELOJ_EXCLUSIVO=1 → declara que el equipo reservó una ventana exclusiva de QA para mover el reloj.
#                        Sin ella, las pruebas de reloj se niegan a correr (salvo con MOCK=1).
#                        La define el pipeline en la ejecución nocturna. No la active "por si acaso".
# LIBERACION_CADA_MS=60000 → (solo mock) ciclo del proceso de liberación; por defecto 5000 para la demo.
